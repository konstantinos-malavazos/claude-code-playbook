{
  "mcpServers": {
    "forgetful": {
      "type": "http",
      "url": "http://localhost:8020/mcp"
    },
    "tracker": {
      "type": "stdio",
      "command": "<your-tracker-mcp-binary-or-npx-package>",
      "args": [],
      "env": {
        "TRACKER_URL": "<YOUR-TRACKER-URL>",
        "TRACKER_TOKEN": "${TRACKER_TOKEN}"
      }
    }
  }
}
