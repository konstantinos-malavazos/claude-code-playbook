{
  "mcpServers": {
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from", "serena-agent==1.7.0",
        "serena", "start-mcp-server",
        "--context", "agent",
        "--project-from-cwd",
        "--enable-web-dashboard", "false"
      ]
    },
    "gitlab": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@zereight/mcp-gitlab"],
      "env": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": "${GITLAB_TOKEN}",
        "GITLAB_API_URL": "<YOUR-GITLAB-API-URL>"
      }
    }
  }
}
