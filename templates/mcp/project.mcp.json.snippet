// Snippet for <workspace>/.mcp.json — PROJECT-scoped MCP servers.
// These are tied to THIS working copy. Enable them in
// <workspace>/.claude/settings.local.json via "enabledMcpjsonServers" (or
// "enableAllProjectMcpServers": true).
{
  "mcpServers": {
    // Serena — ONLY needed if you did NOT install the `serena` plugin (see docs/shared/03 step 2).
    // The plugin route is simpler and is the recommended default; if you use it, DELETE
    // this entry (two registrations = two tool namespaces = confusion).
    //
    // TOOL PREFIX — this must match what your agents' `tools:` lists say:
    //   this .mcp.json entry (key "serena") → mcp__serena__find_symbol
    //   the plugin install                  → mcp__plugin_serena_serena__find_symbol
    // A prefix that doesn't resolve fails SILENTLY: the agent gets no code tools and
    // falls back to reading whole files. Verify with /mcp.
    "serena": {
      "type": "http",
      "url": "http://localhost:9121/mcp"
    },

    // Pick ONE git host (or keep both if your org uses both).
    "gitlab": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@zereight/mcp-gitlab"],
      "env": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": "${GITLAB_TOKEN}",
        "GITLAB_API_URL": "<YOUR-GITLAB-API-URL>"
      }
    }

    // "github": {
    //   "type": "stdio",
    //   "command": "npx",
    //   "args": ["-y", "@modelcontextprotocol/server-github"],
    //   "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}" }
    // }
  }
}
